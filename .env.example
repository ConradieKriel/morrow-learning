# Supabase Project Settings > API. The publishable/anon key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Create a key at https://aistudio.google.com/app/apikey. This key is server-only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Optional backup AI provider. If Gemini is busy or unavailable, Morrow can retry with Groq.
# Keep this key server-only (do not add NEXT_PUBLIC_).
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Keep true while building the interface. Set false to use configured live AI providers.
MORROW_FAKE_MODE=true

# Server-side canonical website origin used when creating share links.
APP_URL=http://localhost:3000
# Optional legacy browser-visible origin; not required by the current app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
